# =============================================
# CMS Platform — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env with real secrets to source control.
# =============================================

# Database
DB_URL=jdbc:postgresql://localhost:5432/cms_db
DB_USER=postgres
DB_PASSWORD=Hello@123!
DB_NAME=cms_db

# JWT
# Must be at least 64 characters for HS256
JWT_SECRET=CHANGE_ME_use_openssl_rand_base64_64_to_generate_this_value
JWT_EXPIRATION=86400000

# Encryption
# Must be a valid Base64-encoded 256-bit key
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME_use_openssl_rand_base64_32_to_generate_this_value

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Mail (Mailtrap for dev, real SMTP for prod)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# pgAdmin (Docker only)
PGADMIN_EMAIL=admin@cms.com
PGADMIN_PASSWORD=admin
