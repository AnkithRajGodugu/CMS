# =============================================
# CMS Platform — Environment Variables
# =============================================

# Database
DB_URL=jdbc:postgresql://localhost:5433/cms_db
DB_USER=postgres
DB_PASSWORD=Hello@123!
DB_NAME=cms_db

# JWT
# 64+ character key for HS256
JWT_SECRET=cms-local-dev-secret-key-that-is-at-least-64-characters-long-for-hs256-algo!!
JWT_EXPIRATION=86400000

# Encryption
# Valid Base64-encoded 256-bit (32 bytes) key
ENCRYPTION_KEY=Y21zLWRldi1lbmNyeXB0aW9uLWtleS0zMmJ5dGVzISE=

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# Mail (Mailtrap for dev — get credentials from https://mailtrap.io -> Email Testing -> SMTP Settings)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# pgAdmin (Docker only)
PGADMIN_EMAIL=admin@cms.com
PGADMIN_PASSWORD=admin
