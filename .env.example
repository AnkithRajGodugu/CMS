# =============================================
# CMS Platform — Environment Variables Example
# Copy this file to .env and fill in REAL values.
# The .env file is gitignored and must NEVER be committed.
# =============================================

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/cms_db
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_NAME=cms_db

# --- JWT (minimum 64 characters for HS256) ---
# Generate: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=dcde7401d03e841be3bb7c49310670df66f6ec9b440a157df0fdd0788a1591419855b023f7f35ea6cd3d924d26e17c18d7e01be3fbc50147db67cedab8297b87
JWT_EXPIRATION=86400000

# --- AES-256 Encryption (Base64-encoded 32-byte key) ---
# Generate (Linux/macOS): openssl rand -base64 32
# Generate (PowerShell):  [Convert]::ToBase64String((1..32 | % { [byte](Get-Random -Max 256) }))
ENCRYPTION_KEY=d30v7rgIjFHn3LtW1iqe1v+Rd4wJPXaGAvqNNm7e38w=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:29092

# --- Mail (use Mailtrap for dev, real SMTP for prod) ---
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=

# --- WebSocket (comma-separated allowed origins) ---
WEBSOCKET_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080

# --- pgAdmin (Docker Compose only) ---
PGADMIN_EMAIL=admin@cms.com
PGADMIN_PASSWORD=admin
